# Copy to .env and fill in. Never commit .env.
# Only NEXT_PUBLIC_* variables may ever reach the browser.

# ---------- Phase 1 ----------
# local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO

# Backend connection. On Supabase use the *Session pooler* string (IPv4) and add ?sslmode=require.
# Plain postgresql:// URLs are fine; the psycopg driver is added automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_intelligence

# Used only by Alembic migrations. Falls back to DATABASE_URL when empty.
DATABASE_MIGRATION_URL=

DB_POOL_SIZE=5
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60
# Protects /admin/* until real authentication exists
ADMIN_API_TOKEN=change-me

# ---------- Phase 2: market data ----------
# Price providers in priority order. If one fails or has no data, the next is tried.
MARKET_DATA_PROVIDERS=yfinance,upstox,eodhd
# Optional. Free key from eodhd.com (20 calls/day, last year only). Without it EODHD is skipped.
EODHD_API_KEY=
# Years of daily history to fetch the first time a listing is collected
PRICE_BACKFILL_YEARS=5

# ---------- Later phases (not used yet) ----------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DOCUMENTS_BUCKET=documents
# NEWS_PROVIDERS=gdelt,rss
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_PROMPT_VERSION=v1
# AI_DAILY_TOKEN_BUDGET=
# SENTIMENT_WEIGHT_NEWS=0.60
# SENTIMENT_WEIGHT_REPORT=0.40
# SENTIMENT_MIN_ITEMS=3
# SCHEDULER_ENABLED=false
# SCHEDULER_TIMEZONE=Asia/Kolkata
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Phase 4: AI analysis. Free key from aistudio.google.com. Without it analysis is skipped.
GEMINI_API_KEY=
# Any Gemini text model; Flash-Lite has the most generous free limits.
GEMINI_MODEL=gemini-3.5-flash-lite
# Upper bound on Gemini requests per run (each request rates up to 20 headlines).
AI_MAX_REQUESTS_PER_RUN=40

# Phase 5: on-demand refreshes (POST /stocks/{ticker}/refresh)
REFRESH_COOLDOWN_MINUTES=15
MAX_ACTIVE_JOBS=3
JOB_STALE_MINUTES=45
