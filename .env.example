# Copy to .env and fill in. Never commit .env.
# Only NEXT_PUBLIC_* variables may ever reach the browser.

# ---------- Phase 1 ----------
# local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO

# Backend connection. On Supabase use the *Session pooler* string (IPv4) and add ?sslmode=require.
# Plain postgresql:// URLs are fine; the psycopg driver is added automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_intelligence

# Used only by Alembic migrations. Falls back to DATABASE_URL when empty.
DATABASE_MIGRATION_URL=

DB_POOL_SIZE=5
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60
# Protects /admin/* until real authentication exists
ADMIN_API_TOKEN=change-me

